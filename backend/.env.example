# PostgreSQL:
DATABASE_URL=postgresql+psycopg2://tp_user:tp_2026@localhost:5432/tp_biblioteca
#DATABASE_URL=postgresql+psycopg2://usuario_postgres:contrasenia_postgres@localhost:5432/tp_biblioteca
# SQLite alternativa (sin instalación):
# DATABASE_URL=sqlite:///./tp_biblioteca.db

# Brevo (envío de correos por API HTTPS):
# 1) Crear cuenta en https://app.brevo.com
# 2) Verificar el correo remitente en "Senders, Domains & Dedicated IPs"
# 3) Generar la clave en "SMTP & API" (empieza con xkeysib-...)
BREVO_API_KEY=tu_clave_de_brevo_aqui
# Correo del remitente verificado en Brevo:
SENDER_EMAIL=correo_remitente@ejemplo.com
# URL del frontend (para el enlace del mail):
FRONTEND_URL=http://localhost:5173